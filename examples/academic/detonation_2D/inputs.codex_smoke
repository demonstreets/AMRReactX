# Codex smoke input: 1-step, small-grid PeleC detonation_2D baseline.
# Keep this cheap enough for repository health checks.
max_step = 1
stop_time = 5.0e-5
geometry.is_periodic = 0 0 0
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 5.0 2.5 0.01
amr.n_cell = 64 32 1
pelec.lo_bc = "SlipWall" "SlipWall" "SlipWall"
pelec.hi_bc = "FOExtrap" "SlipWall" "SlipWall"
pelec.do_hydro = 1
pelec.do_react = 1
pelec.do_mol = 1
pelec.chem_integrator = "ReactorCvode"
pelec.cfl = 0.3
pelec.init_shrink = 0.01
pelec.change_max = 1.05
pelec.plm_iorder = 2
pelec.ppm_type = 1
pelec.use_hybrid_weno = 1
pelec.weno_scheme = 1
pelec.sum_interval = 100
pelec.v = 1
amr.v = 1
amr.max_level = 0
amr.blocking_factor = 32
amr.max_grid_size = 256
amr.checkpoint_files_output = 0
amr.plot_files_output = 0
amr.plot_file = plt
amr.plot_int = -1
prob.x_split = 0.5
prob.p_l = 2.0e7
prob.rho_l = 2.4e-3
prob.p_r = 1.0e6
prob.rho_r = 8.5e-4
prob.T_r = 300.0
cvode.solve_type = GMRES
