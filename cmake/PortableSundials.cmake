# Build the pinned vendored source; never use HOME/.local implicitly.
if(NOT TARGET sundials_cvode)
  enable_language(C)
  set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
  set(BUILD_STATIC_LIBS ON CACHE BOOL "" FORCE)
  set(EXAMPLES_ENABLE_C OFF CACHE BOOL "" FORCE)
  set(EXAMPLES_ENABLE_CXX OFF CACHE BOOL "" FORCE)
  set(EXAMPLES_INSTALL OFF CACHE BOOL "" FORCE)
  set(BUILD_ARKODE OFF CACHE BOOL "" FORCE)
  set(BUILD_CVODES OFF CACHE BOOL "" FORCE)
  set(BUILD_IDA OFF CACHE BOOL "" FORCE)
  set(BUILD_IDAS OFF CACHE BOOL "" FORCE)
  set(BUILD_KINSOL OFF CACHE BOOL "" FORCE)
  set(SUNDIALS_INDEX_SIZE 32 CACHE STRING "" FORCE)
  set(ENABLE_CUDA ${PELE_ENABLE_CUDA} CACHE BOOL "" FORCE)
  set(ENABLE_CUSPARSE ${PELE_ENABLE_CUDA} CACHE BOOL "" FORCE)
  set(ENABLE_CUSOLVERSP ${PELE_ENABLE_CUDA} CACHE BOOL "" FORCE)
  get_filename_component(MYPELE_PORTABLE_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
  add_subdirectory("${MYPELE_PORTABLE_ROOT}/vendor/sundials-6.4.1"
                   "${CMAKE_BINARY_DIR}/portable-sundials")
endif()
