amr.plot_vars = density Temp pressure rho_H2 rho_O2 rho_H2O rho_H rho_O rho_OH rho_HO2 rho_H2O2 rho_N2
amr.derive_plot_vars = x_velocity y_velocity z_velocity
pelec.plot_massfrac = 1

prob.p_0 = 2.0e5
prob.T_0 = 300.0
prob.T_hot = 2214.0
prob.p_hot = 1.8e7
