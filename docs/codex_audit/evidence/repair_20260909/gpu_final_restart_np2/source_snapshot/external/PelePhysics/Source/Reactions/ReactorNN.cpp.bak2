namespace pele::physics::reactions {

// --- Hardcoded normalization parameters from norm_params.json (z-score) ---
// Input:  [T(K), P(atm), Y_H2, Y_H, Y_O, Y_O2, Y_OH, Y_H2O, Y_HO2, Y_H2O2, Y_AR, Y_N2]
// Output: [dY_H2, dY_H, dY_O, dY_O2, dY_OH, dY_H2O, dY_HO2, dY_H2O2, dY_AR, dY_N2, dT(K/s)]

static const float kDefaultXMean[12] = {
  1850.7604f,   // T
  4.970993f,    // P
  0.05218511f,  // Y_H2
  0.04346492f,  // Y_H
  0.04581013f,  // Y_O
  0.06576641f,  // Y_O2
  0.05414438f,  // Y_OH
  0.144767f,    // Y_H2O
  0.04278314f,  // Y_HO2
  0.04249082f,  // Y_H2O2
  0.04236362f,  // Y_AR
  0.4662245f    // Y_N2
};

static const float kDefaultXStd[12] = {
  595.462f,     // T
  7.5771685f,   // P
  0.07438092f,  // Y_H2
  0.07587408f,  // Y_H
  0.07477883f,  // Y_O
  0.07727128f,  // Y_O2
  0.07160318f,  // Y_OH
  0.08253635f,  // Y_H2O
  0.07779451f,  // Y_HO2
  0.0765745f,   // Y_H2O2
  0.07687912f,  // Y_AR
  0.32037088f   // Y_N2
};

static const float kDefaultYMean[11] = {
  1.938106e6f,   // dY_H2
  -2.974633e6f,  // dY_H
  5.929897e5f,   // dY_O
  3.001126e7f,   // dY_O2
  1.192374e7f,   // dY_OH
  5.121435e7f,   // dY_H2O
  -3.244914e6f,  // dY_HO2
  -8.94609e7f,   // dY_H2O2
  0.0f,          // dY_AR (inert)
  0.0f,          // dY_N2 (inert)
  9.099616e9f    // dT
};

static const float kDefaultYStd[11] = {
  8.432478e6f,    // dY_H2
  1.187114e7f,    // dY_H
  1.946901e7f,    // dY_O
  1.099746e8f,    // dY_O2
  3.653895e8f,    // dY_OH
  3.440078e8f,    // dY_H2O
  6.604367e8f,    // dY_HO2
  6.4616e8f,      // dY_H2O2
  1.0f,           // dY_AR
  1.0f,           // dY_N2
  9.705771e10f    // dT
};

// Number of species handled by the NN model
static constexpr int NN_INPUT_DIM = 12;
static constexpr int NN_OUTPUT_DIM = 11;
static constexpr int NN_NSPECIES = 10;
// --- ReactorNN implementation ---

int
ReactorNN::init(int reactor_type, int /*ncells*/)
{
  BL_PROFILE("Pele::ReactorNN::init()");

// Plan A: allow GPU builds with managed memory
// (ReactorNN runs on CPU, accesses GPU arrays via managed memory)
// #ifdef AMREX_USE_GPU
//   amrex::Abort("ReactorNN is CPU-only. Do not compile with USE_CUDA/HIP/SYCL.");
// #endif

  if (NUM_SPECIES != NN_NSPECIES) {
    amrex::Print()
      << "WARNING: ReactorNN expects " << NN_NSPECIES
      << " species (H2, H, O, O2, OH, H2O, HO2, H2O2, AR, N2) but "
      << "current mechanism has " << NUM_SPECIES << " species. "
      << "Species count mismatch — NN input will be zero-padded for missing "
      << "species or truncated for extra species. Results may be inaccurate."
      << std::endl;
  }

  m_reactor_type = reactor_type;
  ReactorTypes::check_reactor_type(m_reactor_type);

  amrex::ParmParse pp("ode");
  pp.query("verbose", verbose);
  pp.query("clean_init_massfrac", m_clean_init_massfrac);

  // Model path: configurable via input file, with sensible default
  m_model_path = "/home/cj/NN_Project/ml_chem/h2o2/h2o2_nn_frozen.pt";
  pp.query("nn_model_path", m_model_path);

  // Load normalization parameters
  m_x_mean.assign(kDefaultXMean, kDefaultXMean + NN_INPUT_DIM);
  m_x_std.assign(kDefaultXStd, kDefaultXStd + NN_INPUT_DIM);
  m_y_mean.assign(kDefaultYMean, kDefaultYMean + NN_OUTPUT_DIM);
  m_y_std.assign(kDefaultYStd, kDefaultYStd + NN_OUTPUT_DIM);

  // Optional: override normalization from input file arrays
  // (not implemented; hardcoded defaults should match the shipped model)

  if (verbose > 0) {
    amrex::Print() << "ReactorNN: loading model from " << m_model_path
                   << std::endl;
  }

  m_nn_model = rnn_load(
    m_model_path.c_str(), m_x_mean.data(), m_x_std.data(), m_y_mean.data(),
    m_y_std.data(), NN_INPUT_DIM, NN_OUTPUT_DIM);

  if (m_nn_model == nullptr) {
    amrex::Abort("ReactorNN: failed to load model from " + m_model_path);
  }

  if (verbose > 0) {
    amrex::Print() << "ReactorNN: model loaded successfully." << std::endl;
  }

  return 0;
}

void
ReactorNN::close()
{
  if (m_nn_model) {
    rnn_free(m_nn_model);
    m_nn_model = nullptr;
  }
}

// --- Array4 (box-based) react ---
// This is the main path called by PeleLMeX.
// Strategy: collect all cell states into a batch, run one NN forward pass,
// then distribute results back.

int
ReactorNN::react(
  const amrex::Box& box,
  amrex::Array4<amrex::Real> const& rY_in,
  amrex::Array4<amrex::Real> const& rYsrc_in,
  amrex::Array4<amrex::Real> const& T_in,
  amrex::Array4<amrex::Real> const& rEner_in,
  amrex::Array4<amrex::Real> const& rEner_src_in,
  amrex::Array4<amrex::Real> const& FC_in,
  amrex::Array4<int> const& /*mask*/,
  amrex::Real& dt_react,
  amrex::Real& time
#ifdef AMREX_USE_GPU
  ,
  amrex::gpuStream_t /*stream*/
#endif
)
{
  BL_PROFILE("Pele::ReactorNN::react()");

  const int ncells = static_cast<int>(box.numPts());
  const auto len = amrex::length(box);
  const auto lo = amrex::lbound(box);

  auto eos = pele::physics::PhysicsType::eos(m_h_eosparm);

  // Step 1: Collect state from each cell into a batch buffer
  std::vector<float> batch_input(ncells * NN_INPUT_DIM);
  std::vector<float> batch_rho(ncells);      // density for write-back
  std::vector<amrex::Real> batch_rhoH(ncells); // enthalpy source
  bool batch_ok = true;

  int idx = 0;
  for (int k = lo.z; k < lo.z + len.z; ++k) {
    for (int j = lo.y; j < lo.y + len.y; ++j) {
      for (int i = lo.x; i < lo.x + len.x; ++i) {
        // Skip covered cells (mask == 0)
        // mask is ignored in this implementation for simplicity;
        // produce a reasonable result for all cells.

        amrex::Real mass_frac[NUM_SPECIES] = {0.0};
        amrex::Real rho = 0.0, rho_inv = 0.0;
        amrex::Real rhoY_local[NUM_SPECIES];

        for (int sp = 0; sp < NUM_SPECIES; sp++) {
          rhoY_local[sp] = rY_in(i, j, k, sp);
        }
        eos.RY2RRinvY(rhoY_local, rho, rho_inv, mass_frac);

        amrex::Real temp = T_in(i, j, k, 0);

        // Compute pressure via EOS
        amrex::Real P = 0.0;
        eos.RTY2P(rho, temp, mass_frac, P);
        // Convert pressure to atm (CGS → atm: 1 atm = 1.01325e6 dyn/cm²)
        P /= 1.01325e6;

        // Assemble input: [T, P, Y_0..Y_9]
        float* in_row = &batch_input[idx * NN_INPUT_DIM];
        in_row[0] = static_cast<float>(temp);
        in_row[1] = static_cast<float>(P);
        // Copy species mass fractions (up to NN_NSPECIES), zero-pad the rest
        const int nsp_copy = (NUM_SPECIES < NN_NSPECIES) ? NUM_SPECIES : NN_NSPECIES;
        for (int sp = 0; sp < nsp_copy; sp++) {
          in_row[2 + sp] = static_cast<float>(mass_frac[sp]);
        }
        for (int sp = nsp_copy; sp < NN_NSPECIES; sp++) {
          in_row[2 + sp] = 0.0f;
        }

        batch_rho[idx] = static_cast<float>(rho);
        batch_rhoH[idx] = rEner_src_in(i, j, k, 0);

        idx++;
      }
    }
  }

  // Step 2: Batch NN forward pass
  std::vector<float> batch_output(ncells * NN_OUTPUT_DIM);
  int ret = rnn_forward_batch(
    m_nn_model, batch_input.data(), ncells, batch_output.data());
  if (ret != 0) {
    amrex::Abort("ReactorNN: NN forward pass failed");
  }

  // Step 3: Apply NN outputs to update cell states
  // Skip chemistry for cold cells (below training data range)
  constexpr amrex::Real MIN_REACT_TEMP = 600.0;  // K
  amrex::Vector<amrex::Real> cell_temp(ncells);
  idx = 0;
  for (int k = lo.z; k < lo.z + len.z; ++k) {
    for (int j = lo.y; j < lo.y + len.y; ++j) {
      for (int i = lo.x; i < lo.x + len.x; ++i) {
        cell_temp[idx] = T_in(i, j, k, 0);
        idx++;
      }
    }
  }

  idx = 0;
  idx = 0;
  for (int k = lo.z; k < lo.z + len.z; ++k) {
    for (int j = lo.y; j < lo.y + len.y; ++j) {
      for (int i = lo.x; i < lo.x + len.x; ++i) {
        // Skip cold cells (outside training data range 800-2800K)
        bool skip_cold = (cell_temp[idx] < MIN_REACT_TEMP);
        const float* out_row = skip_cold ? nullptr : &batch_output[idx * NN_OUTPUT_DIM];
        float rho = batch_rho[idx];

        // For cold cells (T < MIN_REACT_TEMP): skip chemistry update
        if (skip_cold) {
          // No chemical reactions for this cell - leave state unchanged
        } else {
          // NN outputs: [dY_0..dY_9, dT] in [1/s] and [K/s]
          // Euler update: Y_new = Y_old + dY * dt, T_new = T_old + dT * dt
          amrex::Real mass_frac_new[NUM_SPECIES];
          amrex::Real sum_Y = 0.0;

          for (int sp = 0; sp < NUM_SPECIES; sp++) {
            amrex::Real dY_dt = static_cast<amrex::Real>(out_row[sp]);
            amrex::Real rhoY_old = rY_in(i, j, k, sp);
            amrex::Real Y_old = rhoY_old / static_cast<amrex::Real>(rho);
            amrex::Real Y_new = Y_old + dY_dt * dt_react;
            Y_new = amrex::max<amrex::Real>(0.0, amrex::min<amrex::Real>(1.0, Y_new));
            mass_frac_new[sp] = Y_new;
            sum_Y += Y_new;
          }

          // Renormalize mass fractions
          if (sum_Y > 0.0) {
            amrex::Real inv_sum = 1.0 / sum_Y;
            for (int sp = 0; sp < NUM_SPECIES; sp++) {
              mass_frac_new[sp] *= inv_sum;
            }
          }

          // Write back rY = rho * Y_new
          for (int sp = 0; sp < NUM_SPECIES; sp++) {
            rY_in(i, j, k, sp) = static_cast<amrex::Real>(rho) * mass_frac_new[sp];
          }

          // Update temperature
          amrex::Real dT_dt = static_cast<amrex::Real>(out_row[NN_OUTPUT_DIM - 1]);
          amrex::Real T_new = T_in(i, j, k, 0) + dT_dt * dt_react;
          T_new = amrex::max<amrex::Real>(200.0, T_new);
          T_in(i, j, k, 0) = T_new;
        }

        // Update energy: rhoH += src * dt (same as RK64)
        rEner_in(i, j, k, 0) = rEner_in(i, j, k, 0) + dt_react * batch_rhoH[idx];

        // Track function calls
        FC_in(i, j, k, 0) = 1.0;
        idx++;
      }
    }
  }

  time = time + dt_react;
  return 1; // average "steps" per cell (1 NN pass)
}

// --- 1D flat-array react ---
// Same strategy as the box version but for flat arrays.

int
ReactorNN::react(
  amrex::Real* rY_in,
  amrex::Real* rYsrc_in,
  amrex::Real* rX_in,
  amrex::Real* rX_src_in,
  amrex::Real& dt_react,
  amrex::Real& time,
  int ncells
#ifdef AMREX_USE_GPU
  ,
  amrex::gpuStream_t /*stream*/
#endif
)
{
  BL_PROFILE("Pele::ReactorNN::react(1d)");

  auto eos = pele::physics::PhysicsType::eos(m_h_eosparm);
  const int neq = NUM_SPECIES + 1;

  // Step 1: Collect states
  std::vector<float> batch_input(ncells * NN_INPUT_DIM);
  std::vector<float> batch_rho(ncells);

  for (int icell = 0; icell < ncells; icell++) {
    amrex::Real mass_frac[NUM_SPECIES] = {0.0};
    amrex::Real rho = 0.0, rho_inv = 0.0;
    amrex::Real rhoY_local[NUM_SPECIES];

    for (int sp = 0; sp < NUM_SPECIES; sp++) {
      rhoY_local[sp] = rY_in[icell * neq + sp];
    }
    eos.RY2RRinvY(rhoY_local, rho, rho_inv, mass_frac);

    amrex::Real temp = rY_in[icell * neq + NUM_SPECIES];
    amrex::Real P = 0.0;
    eos.RTY2P(rho, temp, mass_frac, P);
    P /= 1.01325e6;

    float* in_row = &batch_input[icell * NN_INPUT_DIM];
    in_row[0] = static_cast<float>(temp);
    in_row[1] = static_cast<float>(P);
    const int nsp_copy = (NUM_SPECIES < NN_NSPECIES) ? NUM_SPECIES : NN_NSPECIES;
    for (int sp = 0; sp < nsp_copy; sp++) {
      in_row[2 + sp] = static_cast<float>(mass_frac[sp]);
    }
    for (int sp = nsp_copy; sp < NN_NSPECIES; sp++) {
      in_row[2 + sp] = 0.0f;
    }
    batch_rho[icell] = static_cast<float>(rho);
  }

  // Step 2: Batch forward
  std::vector<float> batch_output(ncells * NN_OUTPUT_DIM);
  int ret = rnn_forward_batch(
    m_nn_model, batch_input.data(), ncells, batch_output.data());
  if (ret != 0) {
    amrex::Abort("ReactorNN: NN forward pass failed (1d)");
  }

  // Step 3: Apply
  for (int icell = 0; icell < ncells; icell++) {
    const float* out_row = &batch_output[icell * NN_OUTPUT_DIM];
    float rho = batch_rho[icell];

    amrex::Real mass_frac_new[NUM_SPECIES];
    amrex::Real sum_Y = 0.0;
    for (int sp = 0; sp < NUM_SPECIES; sp++) {
      amrex::Real dY_dt = (sp < NN_NSPECIES)
        ? static_cast<amrex::Real>(out_row[sp]) : 0.0;
      amrex::Real rhoY_old = rY_in[icell * neq + sp];
      amrex::Real Y_old = rhoY_old / static_cast<amrex::Real>(rho);
      amrex::Real Y_new = Y_old + dY_dt * dt_react;
      Y_new = amrex::max<amrex::Real>(0.0, amrex::min<amrex::Real>(1.0, Y_new));
      mass_frac_new[sp] = Y_new;
      sum_Y += Y_new;
    }
    if (sum_Y > 0.0) {
      amrex::Real inv_sum = 1.0 / sum_Y;
      for (int sp = 0; sp < NUM_SPECIES; sp++) {
        mass_frac_new[sp] *= inv_sum;
      }
    }
    for (int sp = 0; sp < NUM_SPECIES; sp++) {
      rY_in[icell * neq + sp] = static_cast<amrex::Real>(rho) * mass_frac_new[sp];
    }
    amrex::Real dT_dt = static_cast<amrex::Real>(out_row[NN_OUTPUT_DIM - 1]);
    amrex::Real T_new = rY_in[icell * neq + NUM_SPECIES] + dT_dt * dt_react;
    rY_in[icell * neq + NUM_SPECIES] = amrex::max<amrex::Real>(200.0, T_new);

    rX_in[icell] = rX_in[icell] + dt_react * rX_src_in[icell];
  }

  time = time + dt_react;
  return 1;
}

} // namespace pele::physics::reactions
