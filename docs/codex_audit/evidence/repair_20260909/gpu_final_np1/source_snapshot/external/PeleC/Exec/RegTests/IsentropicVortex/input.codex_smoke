# Codex small solver-coupled isentropic vortex validation smoke
max_step = 2
stop_time = 0.05

geometry.is_periodic = 1 1 1
geometry.coord_sys   = 0
geometry.prob_lo     = 0 0 0
geometry.prob_hi     = 10 10 0.15625
amr.n_cell           = 32 32 2

pelec.lo_bc = "Interior" "Interior" "Interior"
pelec.hi_bc = "Interior" "Interior" "Interior"

pelec.do_hydro = 1
pelec.diffuse_vel = 0
pelec.diffuse_temp = 0
pelec.diffuse_spec = 0
pelec.do_react = 0
pelec.ppm_type = 1
pelec.use_hybrid_weno = 1
pelec.weno_scheme = 1
pelec.cfl = 0.5
pelec.init_shrink = 0.1
pelec.change_max = 1.05
pelec.dt_cutoff = 5.e-20
pelec.sum_interval = 1
pelec.v = 1

amr.v = 1
amr.max_level = 0
amr.blocking_factor = 1
amr.max_grid_size = 32
amr.checkpoint_files_output = 0
amr.plot_files_output = 1
amr.plot_file = plt
amr.plot_int = 1
amr.plot_vars = density Temp
amr.derive_plot_vars = x_velocity y_velocity z_velocity pressure

prob.vortex_eps = 0.5
prob.vortex_R = 1.0
prob.center_x = 5.0
prob.center_y = 5.0
prob.rho_bg = 1.0
prob.u_bg = 1.0
prob.v_bg = 1.0
prob.p_bg = 0.714285714

amrex.abort_on_unused_inputs = 1
