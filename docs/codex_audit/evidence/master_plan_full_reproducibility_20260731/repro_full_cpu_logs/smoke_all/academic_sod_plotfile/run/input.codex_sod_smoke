# Codex-maintained pseudo-1D Sod shock-tube PeleC smoke.
max_step = 60
stop_time = 5.0e-6

geometry.is_periodic = 0 1
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0 0.0
geometry.prob_hi     = 1.0 0.015625
amr.n_cell           = 256 4

pelec.lo_bc        = "FOExtrap" "Interior"
pelec.hi_bc        = "FOExtrap" "Interior"

pelec.do_hydro = 1
pelec.diffuse_vel = 0
pelec.diffuse_temp = 0
pelec.diffuse_spec = 0
pelec.do_react = 0
pelec.allow_negative_energy = 1
pelec.chem_integrator = "ReactorNull"

pelec.cfl            = 0.5
pelec.init_shrink    = 0.2
pelec.change_max     = 1.1
pelec.dt_cutoff      = 5.e-20

pelec.sum_interval   = -1
pelec.v              = 0
amr.v                = 1

amr.max_level       = 0
amr.blocking_factor = 4
amr.max_grid_size   = 64
amr.n_error_buf     = 2 2 2 2

pelec.do_spray_particles = 0

amr.checkpoint_files_output = 0
amr.check_int       = -1
amr.plot_file       = plt
amr.plot_int        = 60
amr.plot_vars       = density xmom ymom rho_E rho_e Temp rho_O2 rho_N2
amr.derive_plot_vars = x_velocity y_velocity pressure

prob.p_left = 1.0e6
prob.T_left = 300.0
prob.p_right = 1.0e5
prob.T_right = 300.0
prob.diaphragm = 0.5
prob.Y_O2 = 0.233
