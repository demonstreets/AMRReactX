#pragma once

namespace Turbulence {

struct KEpsilonConstants {
    const double C_mu    = 0.09;
    const double C_eps1  = 1.44;
    const double C_eps2  = 1.92;
    const double sigma_k = 1.0;
    const double sigma_eps = 1.3;
    const double kappa   = 0.41;    // von Karman constant
    const double Sc_t    = 0.7;     // turbulent Schmidt number (gases)

    // Wall-function constants (Phase 2.3, Launder-Spalding)
    const double B                = 5.0;       // smooth-wall log-law intercept
    const double yplus_threshold  = 30.0;      // log-layer lower bound
    const int    max_newton_iter  = 20;        // Newton max iterations
    const double newton_tol       = 1.0e-8;    // Newton convergence tolerance

    // Numerical clipping (prevents division-by-zero and negative values)
    const double k_min  = 1.0e-14;   // k lower bound
    const double eps_min = 1.0e-14;  // ε lower bound
    const double mu_t_max_ratio = 1.0e5; // μ_t / μ upper bound
};

} // namespace Turbulence
